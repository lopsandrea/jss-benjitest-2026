# BenjiTest -- LLM provider credentials.
# Copy to `.env` and fill in. The LLM Interaction Layer reads these through LiteLLM,
# so any provider supported by LiteLLM works by setting the matching variable.

# OpenAI (gpt-4o-mini, gpt-4.1, o3, o4-mini)
OPENAI_API_KEY=

# Google AI Studio (gemini-1.5-pro, gemini-2.5-pro)
GEMINI_API_KEY=

# xAI (grok-3)
XAI_API_KEY=

# Ollama for locally hosted open-weight models (llama3.1:70b, deepseek-r1)
OLLAMA_API_BASE=http://localhost:11434

# --- External evaluation tooling (optional; auto-detected when on PATH) ---
# Path to the tsDetect executable JAR used for test-smell detection.
TSDETECT_JAR=
# Defects4J checkout (only needed for the RQ5 external validation).
DEFECTS4J_HOME=
